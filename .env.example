# ==============================================================================
# WalletWeather Environment Configuration
# ==============================================================================
# This file contains safe placeholder examples for local development and production.
# NEVER commit your real secrets (.env) to GitHub.
#
# FOR UNIFIED VERCEL DEPLOYMENT:
# Configure all backend variables below in Vercel Project Settings -> Environment Variables.
#
# FOR SEPARATE DEPLOYMENT (Separate Frontend & Backend):
# - BACKEND HOST (Render, Railway, VPS, Vercel Serverless): Needs all BACKEND variables below.
# - FRONTEND HOST (Vercel, Netlify): Needs VITE_API_BASE_URL pointing to backend URL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND: GROQ CLOUD AI CONFIGURATION (Never expose to browser)
# ------------------------------------------------------------------------------
# Get your free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supported Groq Models:
# - openai/gpt-oss-120b (Recommended, 500 tps, deep reasoning MoE)
# - openai/gpt-oss-20b  (Ultra-fast reasoning)
# - qwen/qwen3.8-27b    (Qwen 3.8)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 2. BACKEND: BREVO TRANSACTIONAL EMAIL (OTP Verification)
# ------------------------------------------------------------------------------
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=jazaaa34@gmail.com
BREVO_SENDER_NAME=WalletWeather

# ------------------------------------------------------------------------------
# 3. BACKEND: VISION AI (Bill & Receipt Photo OCR Extraction)
# ------------------------------------------------------------------------------
# Google Gemini Vision API Key (from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Anthropic Claude Vision API Key (fallback OCR provider)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 4. BACKEND: LOCAL SERVER PORT (Optional, defaults to 5173)
# ------------------------------------------------------------------------------
PORT=5173

# ------------------------------------------------------------------------------
# 5. FRONTEND: OPTIONAL API BASE URL (Only needed if frontend & backend are separate)
# ------------------------------------------------------------------------------
# If deploying frontend and backend to the SAME Vercel project, LEAVE THIS EMPTY.
# If deploying frontend separately from backend, set to backend URL (e.g. https://api.walletweather.com):
# VITE_API_BASE_URL=
