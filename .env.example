# ==============================================================================
# WalletWeather Environment Configuration
# ==============================================================================
# Copy this file to .env:
# cp .env.example .env
#
# 1. Get your free Groq API key from https://console.groq.com/keys
# 2. Paste it below (starts with gsk_...)
# 3. This file is ignored by git (.gitignore) and kept secure on the backend server.
# ==============================================================================

GROQ_API_KEY=your_groq_api_key_here
# Supported production models:
# - openai/gpt-oss-120b (Recommended, 500 tps, reasoning MoE)
# - openai/gpt-oss-20b  (Ultra-fast reasoning)
# - llama-3.1-8b-instant (Fast baseline)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Server Port (defaults to 5173)
PORT=5173

# Brevo Transactional Email (OTP Verification)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=jazaaa34@gmail.com
BREVO_SENDER_NAME=WalletWeather

# Anthropic Claude API (Bill Photo Extraction)
# Get your key from https://console.anthropic.com
GEMINI_API_KEY=your_gemini_api_key_here
