{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/send-otp",
      "destination": "/api/auth/send-otp"
    },
    {
      "source": "/api/auth/verify-otp",
      "destination": "/api/auth/verify-otp"
    },
    {
      "source": "/api/bills/extract",
      "destination": "/api/bills/extract"
    },
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/status",
      "destination": "/api/status"
    },
    {
      "source": "/api/test-connection",
      "destination": "/api/test-connection"
    },
    {
      "source": "/api/db/sync",
      "destination": "/api/db/sync"
    },
    {
      "source": "/api/db/status",
      "destination": "/api/db/status"
    },
    {
      "source": "/api/db/user/save",
      "destination": "/api/db/user/save"
    },
    {
      "source": "/api/db/user/find",
      "destination": "/api/db/user/find"
    },
    {
      "source": "/api/db/(.*)",
      "destination": "/api/db/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
